{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "SessionStart"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "SessionEnd"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "SubagentStart"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "SubagentStop"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.js",
              "hook",
              "Stop"
            ]
          }
        ]
      }
    ]
  }
}
