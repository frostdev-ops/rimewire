#!/usr/bin/env python3
"""Post or list agent updates on work packages; the board shows them live.

  wp-note note     WP-C1 "Reviewer asked for a lock-gating test; adding it"
  wp-note progress WP-C1 -p 60 "Engine offers and grants done; fetch next"
  wp-note blocker  WP-C1 "Needs ClipboardHost::clear, not in the frozen trait"
  wp-note unblock  WP-C1 "Lead froze clear(); continuing"
  wp-note ready    WP-C1 "Acceptance commands pass; report in the final message"
  wp-note list     [WP-C1] [-n 20] [--json]

Updates go to target/wp-notes/notes.jsonl in the checkout that contains the current directory (a
worktree or the main repo). No network, no git, nothing outside that checkout is written. TEXT may
be `-` to read it from stdin.
"""

import sys

sys.dont_write_bytecode = True

import argparse  # noqa: E402
import json  # noqa: E402
import os  # noqa: E402
import re  # noqa: E402
import time  # noqa: E402
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent))
import journal  # noqa: E402


def find_checkout(start: Path) -> Path:
    for d in (start, *start.parents):
        if (d / ".git").exists():
            return d
    raise SystemExit("wp-note: run this inside the repository or one of its worktrees (or pass --checkout)")


def main_repo(checkout: Path) -> Path:
    """The main repository a worktree belongs to (its `.git` file names `<repo>/.git/worktrees/<name>`)."""
    dot_git = checkout / ".git"
    if dot_git.is_file():
        text = dot_git.read_text(encoding="utf-8", errors="replace").strip()
        if text.startswith("gitdir:"):
            gitdir = Path(text[7:].strip())
            if not gitdir.is_absolute():
                gitdir = (checkout / gitdir).resolve()
            if gitdir.parent.name == "worktrees":
                return gitdir.parent.parent.parent
    return checkout


def known(wp: str, roots: list[Path]) -> bool:
    pattern = re.compile(rf"(?<![\w.-]){re.escape(wp)}(?![\w-]|\.\d)")
    for root in roots:
        wp_dir = root / "docs" / "wp"
        if (wp_dir / f"{wp}.md").is_file():
            return True
        try:
            if pattern.search((wp_dir / "README.md").read_text(encoding="utf-8", errors="replace")):
                return True
        except OSError:
            pass
    return False


def default_author(checkout: Path, repo: Path) -> str:
    return os.environ.get("CROSSPANE_AGENT") or (checkout.name if checkout != repo else os.environ.get("USER", "lead"))


def post(args) -> int:
    checkout = args.checkout.resolve() if args.checkout else find_checkout(Path.cwd().resolve())
    repo = main_repo(checkout)
    text = " ".join(args.text)
    if text == "-":
        text = sys.stdin.read()
    if args.kind == "progress" and args.percent is None and not text.strip():
        print("wp-note: a progress update needs --percent, text, or both", file=sys.stderr)
        return 2
    try:
        note = journal.make(args.wp, args.kind, text, args.percent, args.author or default_author(checkout, repo))
    except ValueError as exc:
        print(f"wp-note: {exc}", file=sys.stderr)
        return 2
    if not known(note["wp"], [checkout, repo]):
        print(f"wp-note: warning: {note['wp']} is not in docs/wp/README.md or docs/wp/ (posted anyway)", file=sys.stderr)
    try:
        path = journal.append(checkout, note)
    except OSError as exc:
        print(f"wp-note: could not write the journal: {exc}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(note, ensure_ascii=False))
    else:
        pct = f" ({note['percent']}%)" if note["percent"] is not None else ""
        try:
            where = path.relative_to(repo)
        except ValueError:
            where = path
        print(f"wp-note: {note['kind']} on {note['wp']}{pct} as {note['author']} -> {where}")
    return 0


def show(args) -> int:
    checkout = args.checkout.resolve() if args.checkout else find_checkout(Path.cwd().resolve())
    repo = main_repo(checkout)
    notes = journal.read_all(repo, [checkout])
    if args.wp:
        notes = [n for n in notes if n["wp"] == args.wp]
    notes = notes[-args.n :] if args.n > 0 else notes
    if args.json:
        print(json.dumps(notes, ensure_ascii=False, indent=1))
        return 0
    if not notes:
        print("No updates yet.")
    for n in notes:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(n["time"]))
        kind = n["kind"] + (f" {n['percent']}%" if n["percent"] is not None else "")
        first, *rest = (n["text"] or "").splitlines() or [""]
        print(f"{when}  {n['wp']:<12} {kind:<13} {n['author']} ({n['source']})  {first}")
        for line in rest:
            print(f"{'':>50}{line}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="wp-note", description=__doc__.split("\n\n")[0], epilog=__doc__.split("\n\n", 1)[1],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="kind", required=True, metavar="{note,progress,blocker,unblock,ready,list}")
    for kind, about in (
        ("note", "a free-form note"),
        ("progress", "how far along the package is"),
        ("blocker", "work is stopped; say what is needed"),
        ("unblock", "the blocker is resolved"),
        ("ready", "done and ready for review"),
    ):
        p = sub.add_parser(kind, help=about)
        p.add_argument("wp", help="work-package id, e.g. WP-C1")
        p.add_argument("text", nargs="*", help="the update (`-` reads stdin)")
        if kind in ("progress", "ready"):
            p.add_argument("-p", "--percent", type=int, help="0-100")
        p.set_defaults(func=post, percent=None)
    p = sub.add_parser("list", help="show recent updates from every checkout")
    p.add_argument("wp", nargs="?", help="only this work package")
    p.add_argument("-n", type=int, default=20, help="how many (0 for all; default 20)")
    p.set_defaults(func=show)
    for p in sub.choices.values():
        p.add_argument("--author", help="who is posting (default $CROSSPANE_AGENT, else the worktree name)")
        p.add_argument("--checkout", type=Path, help="checkout to write to (default: the one containing cwd)")
        p.add_argument("--json", action="store_true", help="machine-readable output")
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
